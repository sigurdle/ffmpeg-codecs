# Emscripten build outputs (regenerated by each build.sh)
*.wasm
*.mjs
*.o
*.js

# ...but the table extractors are source, not build output: they generate the
# committed *_tables.h from an FFmpeg checkout and are part of the scripts used
# to produce the decoder.
!extract_tables.mjs

# ...and so is a JS file that holds ported tables: its FFmpeg-derived data ships in the app.
!qt_palette.js
